    <p style="margin:24px 0"><a href="{{ shop.url }}" style="display:inline-block;background:#4B3FA8;color:#FFFFFF;padding:14px 24px;border-radius:999px;text-decoration:none;font-weight:600">Volver a la tienda</a></p>
  </td></tr>
  <tr><td style="padding:18px 28px 26px;font-size:12px;color:#5E5A70;border-top:1px solid #F2EFFA">NovaParfum · Perfumería online en Uruguay</td></tr>
</table>
</td></tr></table>
