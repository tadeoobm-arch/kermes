{%- comment -%}
  Portada "Arco": un arco lila se abre de abajo hacia arriba y adentro aparece el frasco NovaParfum
  sobre un pedestal. La tapa se levanta, hace un arco en el aire y se apoya al lado del frasco;
  el atomizador rocía una bruma que cruza hacia el nombre. Al costado, "nova / parfum" sube
  línea por línea. Después: el perfume ondula, un brillo recorre el vidrio y la luz del arco respira.
  Tocar el frasco vuelve a rociar. Con "reducir movimiento" se ve la escena final, quieta.
{%- endcomment -%}
{%- liquid
  assign u = section.id
-%}
<style>
  .na { --na-ink: var(--c-ink, #1F1B2E); --na-iris: var(--c-iris, #6E5BB5); --na-soft: #77708A; --na-gold: #B08D57;
    --na-out: cubic-bezier(.23, 1, .32, 1); --na-io: cubic-bezier(.77, 0, .175, 1);
    position: relative; overflow: hidden; isolation: isolate; background: var(--c-bg, #F7F3EE);
    min-height: max(600px, calc(100svh - 112px)); display: grid; align-items: center; }
  .na__inner { width: 100%; max-width: 1240px; margin: 0 auto; padding: clamp(32px, 6vh, 72px) clamp(20px, 4vw, 48px);
    display: grid; align-items: center; gap: clamp(28px, 5vw, 72px); }
  .na__eyebrow { display: flex; align-items: center; gap: 12px; margin: 0 0 20px; font-size: 11px; font-weight: 700; letter-spacing: .32em; text-transform: uppercase; color: var(--na-soft); }
  .na__eyebrow::before { content: ''; width: 36px; height: 1px; background: currentColor; }
  .na__word { margin: 0; font: 400 clamp(64px, 9.2vw, 148px)/.88 var(--f-display, 'Fraunces', serif); letter-spacing: -.045em; color: var(--na-ink); }
  .na__line { display: block; overflow: hidden; padding: 0 .04em .12em 0; }
  .na__line > span { display: inline-block; }
  .na__line--2 > span { font-style: italic; color: var(--na-iris); padding-left: .55em; }
  .na__sub { margin: 22px 0 0; max-width: 40ch; color: var(--na-soft); font-size: 16px; line-height: 1.7; }
  .na__cta { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 26px; margin-top: 30px; }
  .na-btn { display: inline-flex; align-items: center; gap: 12px; min-height: 54px; padding: 8px 8px 8px 26px; border-radius: 999px; text-decoration: none; font-weight: 700;
    background: var(--na-ink); color: #fff; box-shadow: 0 18px 36px -22px rgba(31,27,46,.7); transition: transform .45s var(--na-out), box-shadow .45s var(--na-out); }
  .na-btn span { display: grid; place-items: center; width: 38px; height: 38px; border-radius: 50%; background: rgba(255,255,255,.14); transition: transform .45s var(--na-out); }
  .na-btn svg { width: 16px; height: 16px; }
  .na-link { position: relative; padding: 6px 0; font-weight: 700; color: var(--na-ink); text-decoration: none; }
  .na-link::after { content: ''; position: absolute; left: 0; right: 0; bottom: 2px; height: 1px; background: currentColor; transform-origin: right; transition: transform .5s var(--na-out); }
  @media (hover: hover) and (pointer: fine) {
    .na-btn:hover { transform: translateY(-2px); box-shadow: 0 24px 40px -20px rgba(31,27,46,.6); }
    .na-btn:hover span { transform: translate(3px, -2px); }
    .na-link:hover::after { transform: scaleX(0); }
  }
  .na-btn:active { transform: scale(.98); }

  /* Arco */
  .na__arch { position: relative; justify-self: center; width: min(100%, 470px); aspect-ratio: 4 / 5; border-radius: 999px 999px 28px 28px; overflow: hidden;
    background: radial-gradient(70% 45% at 50% 38%, rgba(255,255,255,.75), rgba(255,255,255,0) 70%), linear-gradient(180deg, #F1E9F8 0%, #E3D5F1 58%, #D4C2EA 100%);
    box-shadow: 0 40px 80px -50px rgba(70,50,120,.55); }
  .na__arch::before { content: ''; position: absolute; inset: 14px; border-radius: inherit; border: 1px solid rgba(176,141,87,.45); pointer-events: none; z-index: 2; }
  .na__glow { position: absolute; left: 50%; top: 30%; width: 80%; aspect-ratio: 1; translate: -50% -50%; border-radius: 50%;
    background: radial-gradient(closest-side, rgba(255,255,255,.7), rgba(255,255,255,0)); pointer-events: none; }
  .na__rise { position: absolute; inset: 0; }
  .na__btl { all: unset; position: absolute; left: 4%; right: 4%; bottom: 2.5%; cursor: pointer; -webkit-tap-highlight-color: transparent; }
  .na__btl:focus-visible { outline: 2px solid var(--na-iris); outline-offset: 6px; border-radius: 18px; }
  .na__svg { display: block; width: 100%; height: auto; overflow: visible; transition: transform .25s var(--na-out); transform-origin: 37% 90%; }
  .na__btl:active .na__svg { transform: scale(.985); }
  .na__svg .cap { transform-box: fill-box; transform-origin: 50% 50%; transform: translate(140px, 184px); }
  .na__svg .wave { transform-box: fill-box; }
  .na__svg .sheen { transform-box: fill-box; transform: translateX(-170px) skewX(-16deg); }
  .na__hint { position: absolute; left: 0; right: 0; top: 13%; z-index: 3; margin: 0; text-align: center; font-size: 10.5px; font-weight: 700; letter-spacing: .26em; text-transform: uppercase; color: rgba(110,91,181,.75); pointer-events: none; }

  .na__fx { position: absolute; inset: 0; pointer-events: none; z-index: 4; }
  .na__p { position: absolute; left: 0; top: 0; border-radius: 50%; pointer-events: none;
    background: radial-gradient(circle, rgba(140,116,220,.7) 0%, rgba(140,116,220,.25) 45%, rgba(140,116,220,0) 70%); }

  @media (min-width: 990px) { .na__inner { grid-template-columns: 1.05fr .95fr; } }
  @media (max-width: 989px) {
    .na__inner { text-align: center; padding-top: 18px; padding-bottom: 40px; gap: 22px; }
    .na__arch { order: -1; width: min(64vw, 300px); }
    .na__eyebrow { justify-content: center; } .na__eyebrow::before { display: none; }
    .na__word { font-size: clamp(50px, 13.5vw, 96px); }
    .na__eyebrow { margin-bottom: 12px; } .na__sub { margin-top: 14px; } .na__cta { margin-top: 20px; }
    .na__line--2 > span { padding-left: 0; }
    .na__sub { margin-inline: auto; font-size: 15px; }
    .na__cta { justify-content: center; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .na__arch { animation: naArch 1.3s var(--na-io) backwards; }
    .na__glow { animation: naGlow 6s ease-in-out 2.4s infinite; }
    .na__rise { animation: naRise 1.2s var(--na-out) .55s backwards; }
    .na__svg .cap { animation: naCap 1.5s cubic-bezier(.65, 0, .35, 1) 1.5s backwards; }
    .na__svg .capshadow { animation: naFade .4s ease 2.85s backwards; }
    .na__svg .wave { animation: naWave 5s linear infinite; }
    .na__svg .sheen { animation: naSheen 6.5s var(--na-out) 3.2s infinite; }
    .na__eyebrow { animation: naUp .9s var(--na-out) .3s backwards; }
    .na__line > span { animation: naLine 1.1s var(--na-out) .45s backwards; }
    .na__line--2 > span { animation-delay: .6s; }
    .na__sub { animation: naUp .9s var(--na-out) 1s backwards; }
    .na__cta { animation: naUp .9s var(--na-out) 1.15s backwards; }
    .na__hint { animation: naFade 1s ease 3.6s backwards; }
    @keyframes naArch { from { clip-path: inset(100% 0 0 0 round 999px 999px 28px 28px); } to { clip-path: inset(0 0 0 0 round 999px 999px 28px 28px); } }
    @keyframes naGlow { 0%, 100% { opacity: 1; } 50% { opacity: .55; } }
    @keyframes naRise { from { opacity: 0; transform: translateY(26px); } }
    @keyframes naCap {
      0% { transform: none; }
      22% { transform: translate(0, -34px) rotate(-5deg); }
      58% { transform: translate(104px, -26px) rotate(10deg); }
      86% { transform: translate(140px, 190px) rotate(0); }
      100% { transform: translate(140px, 184px); }
    }
    @keyframes naFade { from { opacity: 0; } }
    @keyframes naWave { to { transform: translateX(-120px); } }
    @keyframes naSheen { 0%, 60% { transform: translateX(-170px) skewX(-16deg); } 100% { transform: translateX(210px) skewX(-16deg); } }
    @keyframes naUp { from { opacity: 0; transform: translateY(14px); } }
    @keyframes naLine { from { transform: translateY(105%); } }
  }
</style>

<section class="na" id="na-{{ u }}">
  <div class="na__inner">
    <div class="na__copy">
      {%- if section.settings.eyebrow != blank -%}<p class="na__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h1 class="na__word"><span class="na__line"><span>{{ section.settings.word_1 }}</span></span><span class="na__line na__line--2"><span>{{ section.settings.word_2 }}</span></span></h1>
      {%- if section.settings.subtitle != blank -%}<p class="na__sub">{{ section.settings.subtitle }}</p>{%- endif -%}
      <div class="na__cta">
        <a class="na-btn" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}<span aria-hidden="true"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M5 11 11 5M6 5h5v5"/></svg></span></a>
        {%- if section.settings.button2_label != blank -%}<a class="na-link" href="{{ section.settings.button2_link | default: '#combos' }}">{{ section.settings.button2_label }}</a>{%- endif -%}
      </div>
    </div>

    <div class="na__arch">
      <span class="na__glow" aria-hidden="true"></span>
      {%- if section.settings.hint != blank -%}<p class="na__hint" aria-hidden="true">{{ section.settings.hint }}</p>{%- endif -%}
      <div class="na__rise">
        <button class="na__btl" type="button" aria-label="Rociar perfume" data-na-btl>
          <svg class="na__svg" viewBox="0 0 300 330" aria-hidden="true">
            <defs>
              <linearGradient id="naGlass-{{ u }}" x1="0" y1="0" x2="1" y2="0">
                <stop offset="0" stop-color="#fff" stop-opacity=".8"/><stop offset=".12" stop-color="#fff" stop-opacity=".3"/>
                <stop offset=".85" stop-color="#fff" stop-opacity=".2"/><stop offset="1" stop-color="#fff" stop-opacity=".7"/>
              </linearGradient>
              <linearGradient id="naLiq-{{ u }}" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="{{ section.settings.liquid_top }}"/><stop offset="1" stop-color="{{ section.settings.liquid_bottom }}"/>
              </linearGradient>
              <linearGradient id="naGold-{{ u }}" x1="0" y1="0" x2="1" y2="0">
                <stop offset="0" stop-color="#8E6C3C"/><stop offset=".4" stop-color="#F3E1B5"/><stop offset=".65" stop-color="#C9A46A"/><stop offset="1" stop-color="#7E6034"/>
              </linearGradient>
              <linearGradient id="naCap-{{ u }}" x1="0" y1="0" x2="1" y2="0">
                <stop offset="0" stop-color="#211A33"/><stop offset=".28" stop-color="#5A4C8C"/><stop offset=".5" stop-color="#352B55"/><stop offset="1" stop-color="#14101E"/>
              </linearGradient>
              <linearGradient id="naPodTop-{{ u }}" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#FBF8F3"/><stop offset="1" stop-color="#EDE5DA"/></linearGradient>
              <linearGradient id="naPodSide-{{ u }}" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#D9CFC2"/><stop offset=".5" stop-color="#F3EDE5"/><stop offset="1" stop-color="#CFC4B6"/></linearGradient>
              <radialGradient id="naShadow-{{ u }}"><stop offset="0" stop-color="#1F1B2E" stop-opacity=".32"/><stop offset="1" stop-color="#1F1B2E" stop-opacity="0"/></radialGradient>
              <clipPath id="naBody-{{ u }}"><rect x="30" y="116" width="160" height="186" rx="16"/></clipPath>
              <clipPath id="naIn-{{ u }}"><rect x="42" y="128" width="136" height="150" rx="9"/></clipPath>
            </defs>

            <!-- pedestal -->
            <path d="M12 304 V318 A138 14 0 0 0 288 318 V304 Z" fill="url(#naPodSide-{{ u }})"/>
            <ellipse cx="150" cy="304" rx="138" ry="14" fill="url(#naPodTop-{{ u }})"/>
            <ellipse cx="110" cy="302" rx="92" ry="8" fill="url(#naShadow-{{ u }})"/>
            <ellipse class="capshadow" cx="250" cy="302" rx="40" ry="6" fill="url(#naShadow-{{ u }})"/>

            <!-- atomizador -->
            <rect x="104" y="82" width="12" height="20" fill="#8E6C3C"/>
            <rect x="94" y="66" width="32" height="20" rx="5" fill="url(#naGold-{{ u }})"/>
            <circle class="nozzle" cx="95.5" cy="75" r="2.2" fill="#4A3A24"/>
            <rect x="86" y="98" width="48" height="20" rx="3" fill="url(#naGold-{{ u }})"/>
            <path d="M86 104 H134 M86 110 H134" stroke="#7E6034" stroke-width=".7" opacity=".7"/>

            <!-- vidrio grueso -->
            <g clip-path="url(#naBody-{{ u }})">
              <rect x="30" y="116" width="160" height="186" fill="#fff" opacity=".45"/>
              <rect x="34" y="278" width="152" height="22" fill="{{ section.settings.liquid_bottom }}" opacity=".28"/>
            </g>
            <g clip-path="url(#naIn-{{ u }})">
              <g class="wave"><path d="M0 146 C20 139 40 139 60 146 S100 153 120 146 S160 139 180 146 S220 153 240 146 S280 139 300 146 S340 153 360 146 V290 H0Z" fill="url(#naLiq-{{ u }})"/></g>
              <rect x="42" y="128" width="136" height="150" fill="none" stroke="#fff" stroke-opacity=".5" stroke-width="2"/>
            </g>
            <g clip-path="url(#naBody-{{ u }})"><rect class="sheen" x="40" y="100" width="30" height="230" fill="#fff" opacity=".5"/></g>
            <rect x="30" y="116" width="160" height="186" rx="16" fill="url(#naGlass-{{ u }})" stroke="rgba(60,48,96,.2)" stroke-width="1.2"/>
            <rect x="38" y="126" width="5" height="168" rx="2.5" fill="#fff" opacity=".85"/>
            <rect x="180" y="132" width="2.5" height="150" rx="1.25" fill="#fff" opacity=".6"/>
            <path d="M48 121 H172" stroke="#fff" stroke-width="2" stroke-linecap="round" opacity=".7"/>
            <path d="M40 292 H180" stroke="#fff" stroke-width="1.5" stroke-linecap="round" opacity=".6"/>

            <!-- grabado -->
            <text x="110" y="210" text-anchor="middle" font-family="Fraunces, serif" font-size="23" letter-spacing="7" fill="#fff" opacity=".95">NOVA</text>
            <path d="M84 220 H136" stroke="#fff" stroke-width=".8" opacity=".8"/>
            <text x="110" y="234" text-anchor="middle" font-family="Fraunces, serif" font-style="italic" font-size="11" letter-spacing="2" fill="#fff" opacity=".95">parfum</text>
            <text x="110" y="262" text-anchor="middle" font-family="Manrope, sans-serif" font-size="5.5" font-weight="700" letter-spacing="2.2" fill="#fff" opacity=".8">EAU DE PARFUM · 100 ML</text>

            <!-- tapa -->
            <g class="cap">
              <rect x="80" y="40" width="60" height="78" rx="7" fill="url(#naCap-{{ u }})"/>
              <rect x="80" y="40" width="60" height="7" rx="3" fill="#fff" opacity=".12"/>
              <rect x="88" y="46" width="5" height="60" rx="2.5" fill="#fff" opacity=".2"/>
              <rect x="80" y="110" width="60" height="8" rx="2" fill="url(#naGold-{{ u }})"/>
            </g>
          </svg>
        </button>
      </div>
    </div>
  </div>
  <div class="na__fx" aria-hidden="true"></div>
</section>
<script>
  (() => {
    const root = document.getElementById('na-{{ u }}');
    if (!root || !root.animate) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const fx = root.querySelector('.na__fx'), nozzle = root.querySelector('.nozzle'), btl = root.querySelector('[data-na-btl]');
    let ready = false, busy = false;

    // Rocío: la bruma sale del atomizador hacia la izquierda (hacia el nombre) y se expande
    const spray = (n) => {
      const r = root.getBoundingClientRect(), z = nozzle.getBoundingClientRect();
      const ox = z.left + z.width / 2 - r.left, oy = z.top + z.height / 2 - r.top;
      const k = Math.min(1.3, Math.max(.7, root.querySelector('.na__arch').offsetWidth / 420));
      for (let i = 0; i < n; i++) {
        const p = document.createElement('i'); p.className = 'na__p';
        const s = (8 + Math.random() * 22) * k;
        p.style.width = p.style.height = s + 'px'; p.style.left = ox + 'px'; p.style.top = oy + 'px';
        fx.appendChild(p);
        const a = (192 + (Math.random() - .5) * 42) * Math.PI / 180, d = (90 + Math.random() * 260) * k;
        const dx = Math.cos(a) * d, dy = Math.sin(a) * d - Math.random() * 40 * k;
        p.animate([
          { opacity: 0, transform: 'translate(-50%,-50%) scale(.3)' },
          { opacity: .9, offset: .1 },
          { opacity: 0, transform: `translate(calc(-50% + ${dx.toFixed(1)}px), calc(-50% + ${dy.toFixed(1)}px)) scale(${(1.8 + Math.random() * 2.4).toFixed(2)})` }
        ], { duration: 1700 + Math.random() * 1500, delay: i * 12, easing: 'cubic-bezier(.16,1,.3,1)' }).onfinish = () => p.remove();
      }
    };

    setTimeout(() => { ready = true; spray(40); }, 3050);
    btl.addEventListener('click', () => {
      if (!ready || busy) return;
      busy = true; spray(30); setTimeout(() => (busy = false), 450);
    });
  })();
</script>

{% schema %}
{
  "name": "Portada: arco",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Etiqueta", "default": "Perfumería online · Uruguay" },
    { "type": "text", "id": "word_1", "label": "Nombre · línea 1", "default": "nova" },
    { "type": "text", "id": "word_2", "label": "Nombre · línea 2 (en color)", "default": "parfum" },
    { "type": "textarea", "id": "subtitle", "label": "Texto", "default": "Perfumes de diseñador y árabes, elegidos uno por uno. Pagá con Mercado Pago y recibilo en todo Uruguay en 48 a 72 horas." },
    { "type": "text", "id": "button_label", "label": "Botón", "default": "Ver perfumes" },
    { "type": "url", "id": "button_link", "label": "Enlace del botón" },
    { "type": "text", "id": "button2_label", "label": "Enlace secundario", "default": "Ver combos" },
    { "type": "url", "id": "button2_link", "label": "Destino del enlace secundario" },
    { "type": "text", "id": "hint", "label": "Pista sobre el frasco", "default": "Tocá el frasco ✦" },
    { "type": "color", "id": "liquid_top", "label": "Color del perfume (arriba)", "default": "#D9C6F2" },
    { "type": "color", "id": "liquid_bottom", "label": "Color del perfume (abajo)", "default": "#8E72CF" }
  ],
  "presets": [{ "name": "Portada: arco" }]
}
{% endschema %}
