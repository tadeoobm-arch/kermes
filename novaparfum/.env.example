# =====================================================================
# NovaParfum Ops — variables de entorno
# Copiá este archivo a app/.env (NUNCA lo subas a git) o cargalas como
# secretos en tu hosting (Render / Railway / Fly.io / Cloud Run).
# Todo lo marcado con [CONECTAR] REQUIERE QUE EL USUARIO CONECTE SU CUENTA.
# =====================================================================

# --- General ---------------------------------------------------------
PORT=3000
LOG_LEVEL=info
# true = no envía emails ni WhatsApp (solo registra en logs). Usar en pruebas.
DRY_RUN=true
# URL pública de esta app (sin barra final) [CONECTAR]
APP_URL=
# URL pública de la tienda, p. ej. https://novaparfum.uy [CONECTAR]
STORE_PUBLIC_URL=
TRACKING_PAGE_PATH=/pages/segui-tu-pedido
STORE_TIMEZONE=America/Montevideo
STORE_CURRENCY=UYU
# Cadena aleatoria larga para firmar links del portal de proveedores.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SIGNING_SECRET=
# Token para el cron de conciliación (POST /tasks/reconcile). Generar igual que el anterior.
CRON_SECRET=

# --- Shopify (Dev Dashboard > tu app > Settings) [CONECTAR] ----------
# Dominio myshopify, p. ej. tu-tienda.myshopify.com
SHOPIFY_SHOP=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2026-07
# Solo si usás una app "custom" antigua creada desde el admin (no recomendado para apps nuevas):
SHOPIFY_ADMIN_ACCESS_TOKEN=

# --- Email SMTP [CONECTAR] ------------------------------------------
# Ej. Gmail: smtp.gmail.com / 465 / SMTP_SECURE=true / contraseña de aplicación
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="NovaParfum <pedidos@tu-dominio>"
# Destinatarios de alertas internas (separados por coma)
ADMIN_EMAILS=
NOTIFY_CUSTOMER_PAYMENT_EMAIL=true

# --- Google Sheets (cuenta de servicio) [CONECTAR] -------------------
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_ORDERS_TAB=Pedidos
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Clave privada de la cuenta de servicio en UNA línea con \n literales
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# --- Costos para márgenes (cargá TUS valores reales) -----------------
# Comisión de Mercado Pago en % según el plazo de acreditación de tu cuenta
MP_FEE_PERCENT=
MP_FEE_FIXED=0
# IVA sobre la comisión de Mercado Pago (%), si corresponde a tu situación fiscal
MP_FEE_VAT_PERCENT=
# Costo de envío que paga NovaParfum por cada paquete de proveedor (0 si lo paga el cliente/proveedor)
SHIPPING_COST_PER_SHIPMENT=0
# Si tus precios incluyen IVA y querés el margen neto de IVA, poné el % (si no, 0)
SALES_VAT_PERCENT=0

# --- Empresas de envío: URL de seguimiento con {tracking} ------------
# Completá solo las que uses. Si queda vacío, el cliente ve el número sin link.
CARRIER_TRACKING_URL_DAC=
CARRIER_TRACKING_URL_UES=
CARRIER_TRACKING_URL_MIRTRANS=
CARRIER_TRACKING_URL_CORREO_UY=

# --- WhatsApp Cloud API (opcional) [CONECTAR] ------------------------
WHATSAPP_ENABLED=false
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_LANGUAGE=es
# Nombres de plantillas aprobadas en WhatsApp Manager
WHATSAPP_TEMPLATE_PAGO_CONFIRMADO=
WHATSAPP_TEMPLATE_ENVIADO=
WHATSAPP_TEMPLATE_ENTREGADO=
WHATSAPP_TEMPLATE_CANCELADO=
WHATSAPP_TEMPLATE_PROVEEDOR=

# --- Proveedores sin metaobjeto (respaldo por marca / prefijo SKU) ----
# SUPPLIERS_FILE=../data/suppliers.json
