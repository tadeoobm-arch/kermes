{%- comment -%}
  Logo NovaParfum. Si se carga una imagen en Personalizar > Configuración del tema > Marca, se usa esa.
  Si no, se dibuja el logo vectorial (isotipo "estrella-gota" + wordmark) sin peticiones extra.
{%- endcomment -%}
{%- if settings.logo != blank -%}
  {{ settings.logo | image_url: width: 400 | image_tag: alt: shop.name, loading: 'eager', width: 200, height: settings.logo.height | times: 200 | divided_by: settings.logo.width, widths: '200, 300, 400' }}
{%- else -%}
  <svg viewBox="0 0 236 48" role="img" aria-label="{{ shop.name | escape }}" xmlns="http://www.w3.org/2000/svg">
    <path fill="#4B3FA8" d="M24 4c1.3 9.3 5.2 13.2 14.5 14.5C29.2 19.8 25.3 23.7 24 33c-1.3-9.3-5.2-13.2-14.5-14.5C18.8 17.2 22.7 13.3 24 4Z"/>
    <path fill="none" stroke="#26224A" stroke-width="2" d="M24 44c-6.1 0-11-4.7-11-10.6 0-2.4 1-5 2.6-7.6"/>
    <path fill="none" stroke="#26224A" stroke-width="2" d="M24 44c6.1 0 11-4.7 11-10.6 0-2.4-1-5-2.6-7.6"/>
    <text x="50" y="33" fill="#26224A" font-family="Fraunces, Georgia, serif" font-size="27" font-weight="500" letter-spacing=".2">Nova<tspan font-weight="400" fill="#4B3FA8">Parfum</tspan></text>
  </svg>
{%- endif -%}
