<article class="container section" style="max-width:760px">
  <p class="eyebrow">{{ blog.title }}</p>
  <h1>{{ article.title }}</h1>
  <p class="muted">{{ article.published_at | date: '%d/%m/%Y' }}</p>
  {%- if article.image -%}<div style="border-radius:var(--r-lg);overflow:hidden;margin:20px 0">{{ article.image | image_url: width: 1400 | image_tag: alt: article.image.alt | default: article.title, loading: 'eager', widths: '600, 900, 1400', sizes: '(min-width: 800px) 760px, 100vw' }}</div>{%- endif -%}
  <div class="rte">{{ article.content }}</div>
</article>
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": {{ article.title | json }},
    "datePublished": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
    "dateModified": {{ article.updated_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
    "author": { "@type": "Organization", "name": {{ shop.name | json }} },
    {%- if article.image %}"image": {{ article.image | image_url: width: 1200 | prepend: 'https:' | json }},{% endif %}
    "mainEntityOfPage": {{ request.origin | append: article.url | json }}
  }
</script>
{% schema %}
{ "name": "Artículo", "settings": [] }
{% endschema %}
