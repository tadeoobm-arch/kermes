<div class="container section" style="max-width:640px">
  <h1>{{ section.settings.heading }}</h1>
  <p class="muted">{{ section.settings.text }}</p>
  {%- if settings.whatsapp_number != blank -%}
    <a class="btn btn--primary btn--block" style="margin-bottom:20px" href="https://wa.me/{{ settings.whatsapp_number | remove: '+' | remove: ' ' }}?text={{ settings.whatsapp_message | url_encode }}" target="_blank" rel="noopener">{% render 'icon', icon: 'whatsapp' %} Escribinos por WhatsApp</a>
  {%- endif -%}
  {%- form 'contact', class: 'track' -%}
    {%- if form.posted_successfully? -%}<p class="notice">¡Gracias! Te respondemos a la brevedad.</p>{%- endif -%}
    {%- if form.errors -%}<p class="notice notice--error">{{ form.errors | default_errors }}</p>{%- endif -%}
    <div style="display:grid;gap:14px;background:var(--c-surface);padding:20px;border-radius:var(--r-md)">
      <div class="field"><label for="ContactName">Nombre</label><input id="ContactName" name="contact[name]" autocomplete="name" value="{{ form.name }}"></div>
      <div class="field"><label for="ContactEmail">Email *</label><input id="ContactEmail" type="email" name="contact[email]" autocomplete="email" required value="{{ form.email }}"></div>
      <div class="field"><label for="ContactPhone">Teléfono</label><input id="ContactPhone" type="tel" name="contact[phone]" autocomplete="tel" value="{{ form.phone }}"></div>
      <div class="field"><label for="ContactBody">Mensaje</label><textarea id="ContactBody" name="contact[body]" rows="5">{{ form.body }}</textarea></div>
      <button class="btn btn--primary btn--block" type="submit">Enviar</button>
    </div>
  {%- endform -%}
</div>
{% schema %}
{
  "name": "Formulario de contacto",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Contacto" },
    { "type": "textarea", "id": "text", "label": "Texto", "default": "¿Dudas sobre un perfume o tu pedido? Escribinos." }
  ]
}
{% endschema %}
