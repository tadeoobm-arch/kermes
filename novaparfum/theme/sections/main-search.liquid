{%- paginate search.results by 24 -%}
<div class="container section">
  <h1>{% if search.performed %}Resultados para “{{ search.terms | escape }}”{% else %}Buscar{% endif %}</h1>
  <form action="{{ routes.search_url }}" method="get" role="search" class="search-form" style="margin-bottom:24px">
    <label class="visually-hidden" for="SearchMain">Buscar</label>
    <input id="SearchMain" type="search" name="q" value="{{ search.terms | escape }}" placeholder="Perfume, marca o nota olfativa">
    <input type="hidden" name="type" value="product">
    <input type="hidden" name="options[prefix]" value="last">
    <button class="btn btn--primary" type="submit">Buscar</button>
  </form>
  {%- if search.performed -%}
    {%- if search.results_count == 0 -%}
      <p class="notice">No encontramos resultados. Probá con otra palabra o <a href="{{ routes.collections_url }}/perfumes">mirá todos los perfumes</a>.</p>
    {%- else -%}
      <ul class="product-grid product-grid--4">
        {%- for item in search.results -%}
          {%- if item.object_type == 'product' -%}<li>{% render 'product-card', product: item %}</li>{%- endif -%}
        {%- endfor -%}
      </ul>
      {%- if paginate.pages > 1 -%}<div class="pagination">{{ paginate | default_pagination }}</div>{%- endif -%}
    {%- endif -%}
  {%- endif -%}
</div>
{%- endpaginate -%}
{% schema %}
{ "name": "Búsqueda", "settings": [] }
{% endschema %}
