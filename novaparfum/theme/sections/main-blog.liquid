{%- paginate blog.articles by 12 -%}
<div class="container section">
  <h1>{{ blog.title }}</h1>
  <ul class="product-grid">
    {%- for article in blog.articles -%}
      <li><article class="card">
        {%- if article.image -%}<div class="card__media">{{ article.image | image_url: width: 800 | image_tag: alt: article.image.alt | default: article.title, loading: 'lazy', widths: '300, 500, 800', sizes: '(min-width: 750px) 33vw, 50vw' }}</div>{%- endif -%}
        <div class="card__body"><h2 class="card__title"><a href="{{ article.url }}">{{ article.title }}</a></h2><p class="muted" style="font-size:14px">{{ article.excerpt_or_content | strip_html | truncate: 120 }}</p></div>
      </article></li>
    {%- endfor -%}
  </ul>
  {%- if paginate.pages > 1 -%}<div class="pagination">{{ paginate | default_pagination }}</div>{%- endif -%}
</div>
{%- endpaginate -%}
{% schema %}
{ "name": "Blog", "settings": [] }
{% endschema %}
