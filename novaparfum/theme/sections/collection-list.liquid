<section class="section">
  <div class="container">
    <div class="section__head"><h2>{{ section.settings.heading }}</h2></div>
    <div class="cat-grid">
      {%- for block in section.blocks -%}
        {%- assign c = block.settings.collection -%}
        <a class="cat-card" href="{{ c.url | default: '#' }}" {{ block.shopify_attributes }} style="background: {{ block.settings.bg }}">
          {%- assign img = block.settings.image | default: c.featured_image -%}
          {%- if img -%}
            {{ img | image_url: width: 600 | image_tag: alt: '', loading: 'lazy', widths: '300, 450, 600', sizes: '(min-width: 750px) 25vw, 50vw' }}
          {%- endif -%}
          <span class="cat-card__label">{{ block.settings.label | default: c.title }} {% render 'icon', icon: 'chevron' %}</span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Categorías",
  "settings": [{ "type": "text", "id": "heading", "label": "Título", "default": "Elegí tu estilo" }],
  "blocks": [
    {
      "type": "category",
      "name": "Categoría",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Colección" },
        { "type": "text", "id": "label", "label": "Texto (opcional)" },
        { "type": "image_picker", "id": "image", "label": "Imagen (opcional)" },
        { "type": "color", "id": "bg", "label": "Color de fondo", "default": "#F2EFFA" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [{ "name": "Categorías", "blocks": [{ "type": "category" }, { "type": "category" }, { "type": "category" }, { "type": "category" }] }]
}
{% endschema %}
