{%- if section.settings.text != blank -%}
  <div class="announcement" role="region" aria-label="Anuncio">
    {%- if section.settings.link != blank -%}
      <a href="{{ section.settings.link }}">{{ section.settings.text }}</a>
    {%- else -%}
      {{ section.settings.text }}
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Barra de anuncio",
  "settings": [
    { "type": "text", "id": "text", "label": "Texto", "default": "Envíos a todo Uruguay · Pagá con Mercado Pago" },
    { "type": "url", "id": "link", "label": "Link" }
  ]
}
{% endschema %}
