{%- comment -%}
  Reutilizable para: Perfumes destacados, Más vendidos, Nuevos y Ofertas (cada uno apunta a su colección).
{%- endcomment -%}
{%- assign c = section.settings.collection -%}
<section class="section {% if section.settings.mist %}section--mist{% endif %}">
  <div class="container">
    <div class="section__head">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 style="margin:0">{{ section.settings.heading }}</h2>
      </div>
      {%- if c != blank -%}<a class="link-arrow" href="{{ c.url }}">Ver todo →</a>{%- endif -%}
    </div>
    <ul class="product-grid product-grid--4">
      {%- if c != blank and c.products_count > 0 -%}
        {%- for product in c.products limit: section.settings.limit -%}
          <li>{% render 'product-card', product: product %}</li>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..4) -%}
          <li><article class="card"><div class="card__media">{{ 'product-1' | placeholder_svg_tag: 'placeholder' }}</div><div class="card__body"><span class="card__brand">Marca</span><h3 class="card__title">Perfume de ejemplo</h3></div></article></li>
        {%- endfor -%}
      {%- endif -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Colección destacada",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Perfumes destacados" },
    { "type": "collection", "id": "collection", "label": "Colección" },
    { "type": "range", "id": "limit", "label": "Cantidad", "min": 2, "max": 12, "step": 1, "default": 4 },
    { "type": "checkbox", "id": "mist", "label": "Fondo lavanda suave", "default": false }
  ],
  "presets": [{ "name": "Colección destacada" }]
}
{% endschema %}
