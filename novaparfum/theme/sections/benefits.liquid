<section class="section {% if section.settings.mist %}section--mist{% endif %}">
  <div class="container">
    {%- if section.settings.heading != blank -%}<div class="section__head"><h2>{{ section.settings.heading }}</h2></div>{%- endif -%}
    <div class="benefits">
      {%- for block in section.blocks -%}
        <div class="benefit" {{ block.shopify_attributes }}>
          {% render 'icon', icon: block.settings.icon %}
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Beneficios",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Comprar en NovaParfum" },
    { "type": "checkbox", "id": "mist", "label": "Fondo lavanda suave", "default": true }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Beneficio",
      "settings": [
        { "type": "select", "id": "icon", "label": "Ícono", "default": "shield", "options": [
          { "value": "shield", "label": "Escudo" }, { "value": "truck", "label": "Envío" }, { "value": "card", "label": "Pago" },
          { "value": "chat", "label": "Atención" }, { "value": "return", "label": "Cambios" }, { "value": "gift", "label": "Regalo" },
          { "value": "sparkle", "label": "Destello" }, { "value": "clock", "label": "Reloj" }
        ] },
        { "type": "text", "id": "title", "label": "Título", "default": "Perfumes originales" },
        { "type": "textarea", "id": "text", "label": "Texto", "default": "Trabajamos con proveedores confiables." }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [{ "name": "Beneficios", "blocks": [{ "type": "benefit" }, { "type": "benefit" }, { "type": "benefit" }, { "type": "benefit" }] }]
}
{% endschema %}
