<section class="hero">
  <div class="container hero__grid">
    <div class="hero__text">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{% render 'icon', icon: 'sparkle' %} {{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="h1">{{ section.settings.heading }}</h2>
      <p>{{ section.settings.text }}</p>
      <div class="hero__ctas">
        {%- if section.settings.cta1_label != blank -%}<a class="btn btn--primary" href="{{ section.settings.cta1_link | default: '/collections/perfumes' }}">{{ section.settings.cta1_label }}</a>{%- endif -%}
        {%- if section.settings.cta2_label != blank -%}<a class="btn btn--secondary" href="{{ section.settings.cta2_link | default: '/collections/ofertas' }}">{{ section.settings.cta2_label }}</a>{%- endif -%}
      </div>
      <div class="hero__trust">
        <span>{% render 'icon', icon: 'shield' %} Originales</span>
        <span>{% render 'icon', icon: 'truck' %} Envíos a todo Uruguay</span>
        <span>{% render 'icon', icon: 'card' %} Mercado Pago</span>
      </div>
    </div>
    <div class="hero__media">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1400 | image_tag:
          alt: section.settings.image.alt | default: section.settings.heading,
          loading: 'eager', fetchpriority: 'high',
          widths: '400, 600, 800, 1000, 1200, 1400',
          sizes: '(min-width: 750px) 50vw, 100vw' }}
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder' }}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Banner principal",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Imagen (recomendado 1400×1400, fondo claro)" },
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Nueva temporada" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Tu próxima fragancia favorita" },
    { "type": "textarea", "id": "text", "label": "Texto", "default": "Perfumes originales elegidos con criterio. Pagá con Mercado Pago y recibilo en todo Uruguay." },
    { "type": "text", "id": "cta1_label", "label": "Botón principal", "default": "Ver perfumes" },
    { "type": "url", "id": "cta1_link", "label": "Link botón principal" },
    { "type": "text", "id": "cta2_label", "label": "Botón secundario", "default": "Ofertas" },
    { "type": "url", "id": "cta2_link", "label": "Link botón secundario" }
  ],
  "presets": [{ "name": "Banner principal" }]
}
{% endschema %}
