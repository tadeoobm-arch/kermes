<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ shop.name }} — Muy pronto</title>
    <link rel="icon" type="image/svg+xml" href="{{ 'favicon.svg' | asset_url }}">
    {% render 'fonts' %}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body>
    <div class="container" style="padding-top:40px;display:flex;justify-content:center">{% render 'logo' %}</div>
    <main>{{ content_for_layout }}</main>
    <div class="container" style="max-width:420px;padding-bottom:40px">
      {%- form 'storefront_password' -%}
        {{ form.errors | default_errors }}
        <div class="field"><label for="Password">Contraseña</label><input type="password" name="password" id="Password" autocomplete="current-password"></div>
        <button type="submit" class="btn btn--primary btn--block" style="margin-top:12px">Entrar</button>
      {%- endform -%}
    </div>
  </body>
</html>
