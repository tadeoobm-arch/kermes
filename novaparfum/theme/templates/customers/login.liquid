<div class="container section" style="max-width:460px">
  <h1>Ingresar</h1>
  {%- form 'customer_login' -%}
    {{ form.errors | default_errors }}
    <div class="field"><label for="LoginEmail">Email</label><input id="LoginEmail" type="email" name="customer[email]" autocomplete="email" required></div>
    <div class="field" style="margin-top:12px"><label for="LoginPassword">Contraseña</label><input id="LoginPassword" type="password" name="customer[password]" autocomplete="current-password"></div>
    <button class="btn btn--primary btn--block" style="margin-top:16px">Ingresar</button>
  {%- endform -%}
  <p style="margin-top:16px"><a href="{{ routes.account_register_url }}">Crear cuenta</a> · <a href="#recover" onclick="document.getElementById('recover').hidden=false">¿Olvidaste tu contraseña?</a></p>
  <div id="recover" hidden>
    {%- form 'recover_customer_password' -%}
      {%- if form.posted_successfully? -%}<p class="notice">Te enviamos un email para restablecerla.</p>{%- endif -%}
      <div class="field"><label for="RecoverEmail">Email</label><input id="RecoverEmail" type="email" name="email" autocomplete="email"></div>
      <button class="btn btn--secondary btn--block" style="margin-top:12px">Enviar</button>
    {%- endform -%}
  </div>
</div>
