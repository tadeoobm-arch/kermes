<div class="container section" style="max-width:460px">
  <h1>Activar cuenta</h1>
  {%- form 'activate_customer_password' -%}
    {{ form.errors | default_errors }}
    <div class="field"><label for="ActPass">Contraseña</label><input id="ActPass" type="password" name="customer[password]" autocomplete="new-password"></div>
    <div class="field" style="margin-top:12px"><label for="ActPass2">Repetir contraseña</label><input id="ActPass2" type="password" name="customer[password_confirmation]" autocomplete="new-password"></div>
    <button class="btn btn--primary btn--block" style="margin-top:16px">Activar</button>
  {%- endform -%}
</div>
