<div class="container section" style="max-width:460px">
  <h1>Nueva contraseña</h1>
  {%- form 'reset_customer_password' -%}
    {{ form.errors | default_errors }}
    <div class="field"><label for="ResetPass">Contraseña</label><input id="ResetPass" type="password" name="customer[password]" autocomplete="new-password"></div>
    <div class="field" style="margin-top:12px"><label for="ResetPass2">Repetir contraseña</label><input id="ResetPass2" type="password" name="customer[password_confirmation]" autocomplete="new-password"></div>
    <button class="btn btn--primary btn--block" style="margin-top:16px">Guardar</button>
  {%- endform -%}
</div>
