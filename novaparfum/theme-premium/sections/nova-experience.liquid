    { "type": "text", "id": "eyebrow", "label": "Etiqueta", "default": "Nova Parfum · Colección" },
    { "type": "text", "id": "name", "label": "Nombre del perfume (título)", "default": "Nova No. 01" },
    { "type": "textarea", "id": "text_0", "label": "Texto de inicio", "default": "El perfume es una experiencia. Deslizá y descubrí cómo se construye una fragancia, nota por nota." },
    { "type": "text", "id": "button", "label": "Botón", "default": "Descubrir perfumes" },
    { "type": "url", "id": "link", "label": "Enlace del botón" },
    { "type": "text", "id": "button2", "label": "Botón secundario (al final)", "default": "Ver más vendidos" },
    { "type": "url", "id": "link2", "label": "Enlace del botón secundario" },
    { "type": "text", "id": "title_1", "label": "Capítulo 1 · título", "default": "Bergamota & <em>mandarina</em>" },
    { "type": "textarea", "id": "text_1", "label": "Capítulo 1 · texto", "default": "Lo primero que sentís: cítricos brillantes y frescos que abren la fragancia." },
    { "type": "text", "id": "title_2", "label": "Capítulo 2 · título", "default": "Rosa & <em>jazmín</em>" },
    { "type": "textarea", "id": "text_2", "label": "Capítulo 2 · texto", "default": "El corazón del perfume: flores que aparecen a los minutos y le dan su carácter." },
    { "type": "text", "id": "title_3", "label": "Capítulo 3 · título", "default": "Ámbar, vainilla & <em>oud</em>" },
    { "type": "textarea", "id": "text_3", "label": "Capítulo 3 · texto", "default": "Lo que queda en tu piel durante horas: maderas, ámbar y vainilla. Tu firma." }
