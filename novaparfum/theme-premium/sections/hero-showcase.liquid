{%- comment -%}
  Banner principal con perfumes reales que rotan (hasta 3).
  - Cada perfume tiene su color de fondo; la foto (fondo blanco) se funde con "multiply".
    El "multiply" va en la diapositiva (no en la foto) y el escenario no puede crear una capa aislada
    (z-index, transform, filter, animación), o el fondo blanco de la foto vuelve a verse.
  - Cambio automático cada pocos segundos (se pausa al pasar el mouse, al tocar un punto o si la pestaña no está visible).
  - El título grande se desplaza suave con el scroll (solo en navegadores con animaciones por scroll).
  - Portada animada: entrada en secuencia (letras, círculo de luz, perfume que se enfoca, textos en cascada),
    bruma que flota detrás del frasco, "rocío" de partículas al cambiar de perfume, brillo que cruza el círculo
    y estrellitas de la marca que flotan (y siguen levemente al mouse en computadora).
  - Siempre en movimiento: el frasco flota (sube, baja y se balancea) con su sombra en el piso, se inclina en 3D
    siguiendo al mouse, y una órbita de perfumes de la tienda gira alrededor pasando por delante y por detrás.
    La órbita se calcula con JS (cada perfume se mueve solo, para que el "multiply" siga funcionando) y se
    detiene cuando la portada no está en pantalla.
  - Con "reducir movimiento": sin rotación automática, sin bruma, partículas ni órbita; la entrada es solo un fundido.
{%- endcomment -%}
{%- liquid
  assign count = 0
  for i in (1..3)
    assign key = 'product_' | append: i
    if section.settings[key] != blank
      assign count = count | plus: 1
    endif
  endfor
-%}
<style>
  .hs { --hs-ease: cubic-bezier(.32, .72, 0, 1); position: relative; overflow: hidden; isolation: isolate;
    min-height: min(88dvh, 860px); display: grid; align-items: center; background: var(--hs-tint, #E7E1EF);
    transition: background-color 1.1s var(--hs-ease); }
  .hs::before { content: ''; position: absolute; inset: -20%; z-index: -1; pointer-events: none;
    background: radial-gradient(42% 46% at 72% 46%, rgba(255,255,255,.75) 0%, rgba(255,255,255,0) 70%),
                radial-gradient(30% 30% at 12% 90%, rgba(255,255,255,.35) 0%, rgba(255,255,255,0) 70%); }
  .hs__inner { position: relative; display: grid; gap: 28px; padding-block: 56px 72px; }
  .hs__word { position: absolute; z-index: 0; left: 50%; top: 50%; translate: -50% -50%; margin: 0; white-space: nowrap; pointer-events: none;
    font: 500 clamp(88px, 19vw, 290px)/.82 var(--f-display, 'Fraunces', serif); letter-spacing: -.045em; color: rgba(255,255,255,.62);
    text-align: center; user-select: none; }
  .hs__word em { font-style: italic; color: rgba(255,255,255,.4); }
  .hs__copy { position: relative; z-index: 2; max-width: 34rem; }
  .hs__eyebrow { display: inline-flex; align-items: center; gap: 8px; margin: 0 0 18px; padding: 6px 12px; border-radius: 999px;
    background: rgba(255,255,255,.62); font-size: 11px; font-weight: 700; letter-spacing: .18em; text-transform: uppercase; color: var(--c-ink); }
  .hs__eyebrow i { width: 6px; height: 6px; border-radius: 50%; background: var(--c-iris); }
  .hs__brand { margin: 0 0 6px; font-size: 13px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: var(--c-iris); min-height: 1.4em; }
  .hs__title { margin: 0 0 14px; font: 400 clamp(32px, 4.2vw, 54px)/1.04 var(--f-display, 'Fraunces', serif); letter-spacing: -.02em; color: var(--c-ink);
    text-wrap: balance; min-height: 2.08em; }
  .hs__sub { margin: 0 0 26px; max-width: 46ch; color: #4a4560; line-height: 1.6; text-wrap: pretty; }
  .hs__cta { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; }
  .hs-btn { display: inline-flex; align-items: center; gap: 12px; padding: 8px 8px 8px 24px; min-height: 54px; border-radius: 999px;
    font-weight: 700; text-decoration: none; transition: transform .5s var(--hs-ease), box-shadow .5s var(--hs-ease), background-color .3s ease; }
  .hs-btn--main { background: var(--c-ink); color: #fff; box-shadow: 0 18px 34px -18px rgba(47,42,74,.7); }
  .hs-btn--soft { background: rgba(255,255,255,.7); color: var(--c-ink); padding-right: 24px; }
  .hs-btn__ico { display: grid; place-items: center; width: 38px; height: 38px; border-radius: 50%; background: rgba(255,255,255,.14);
    transition: transform .5s var(--hs-ease); }
  .hs-btn__ico svg { width: 16px; height: 16px; }
  @media (hover: hover) and (pointer: fine) {
    .hs-btn:hover { transform: translateY(-2px); }
    .hs-btn--main:hover { box-shadow: 0 24px 40px -18px rgba(47,42,74,.8); }
    .hs-btn:hover .hs-btn__ico { transform: translate(3px, -2px) scale(1.06); }
    .hs-btn--soft:hover { background: #fff; }
  }
  .hs-btn:active { transform: scale(.98); transition-duration: .12s; }

  .hs__stage { position: relative; display: grid; place-items: center; aspect-ratio: 1 / 1; width: min(100%, 520px); justify-self: center; }
  .hs__halo { position: absolute; inset: 9%; border-radius: 50%; background: rgba(255,255,255,.55);
    box-shadow: 0 60px 90px -50px var(--hs-shadow, rgba(122,104,184,.6)); transition: box-shadow 1.1s var(--hs-ease); }
  .hs__slide { position: absolute; inset: 0; display: grid; place-items: center; margin: 0; opacity: 0;
    transform: translateY(28px) scale(.92) rotate(-2deg); filter: blur(6px);
    transition: opacity .9s var(--hs-ease), transform 1.1s var(--hs-ease), filter .9s var(--hs-ease); pointer-events: none;
    mix-blend-mode: multiply; }
  .hs__slide.is-active { opacity: 1; transform: none; filter: none; pointer-events: auto; }
  .hs__slide.is-leaving { opacity: 0; transform: translateY(-22px) scale(1.04) rotate(2deg); filter: blur(4px); }
  .hs__slide a { display: grid; place-items: center; width: 100%; height: 100%; }
  .hs__slide img { width: 78%; height: 78%; object-fit: contain; }
  .hs__dots { position: absolute; z-index: 3; left: 0; right: 0; bottom: 22px; display: flex; justify-content: center; gap: 8px; }
  .hs__dot { width: 34px; height: 4px; padding: 0; border: 0; border-radius: 4px; background: rgba(47,42,74,.18); cursor: pointer; overflow: hidden; position: relative; }
  .hs__dot::after { content: ''; position: absolute; inset: 0; background: var(--c-ink); transform: scaleX(0); transform-origin: left; }
  .hs__dot[aria-current="true"]::after { animation: hsBar var(--hs-delay, 5.5s) linear forwards; }
  .hs.is-paused .hs__dot[aria-current="true"]::after { animation-play-state: paused; }
  .hs:not(.is-auto) .hs__dot[aria-current="true"]::after { animation: none; transform: none; }
  @keyframes hsBar { to { transform: scaleX(1); } }
  .hs__text-swap { transition: opacity .45s ease, transform .6s var(--hs-ease); }
  .hs__text-swap.is-out { opacity: 0; transform: translateY(10px); }

  @media (min-width: 990px) {
    .hs__inner { grid-template-columns: 1fr 1fr; gap: 48px; padding-block: 72px 96px; }
  }
  @media (max-width: 989px) {
    .hs { min-height: auto; }
    .hs__inner { text-align: center; padding-block: 36px 64px; }
    .hs__copy { order: 2; justify-self: center; }
    .hs__cta { justify-content: center; }
    .hs__stage { width: min(78vw, 380px); }
    .hs__word { top: 30%; }
  }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .hs__word { animation: hsDrift linear both; animation-timeline: view(); animation-range: exit 0% exit 100%; }
      @keyframes hsDrift { to { transform: translateY(-18%); opacity: .3; } }
    }
  }
  /* ---------- Portada animada ---------- */
  .hs { --hs-out: cubic-bezier(.23, 1, .32, 1); }
  .hs__ch { display: inline-block; }
  .hs__halo { overflow: hidden; }
  .hs__halo::after { content: ''; position: absolute; inset: -10%; pointer-events: none;
    background: linear-gradient(115deg, rgba(255,255,255,0) 38%, rgba(255,255,255,.75) 50%, rgba(255,255,255,0) 62%);
    transform: translateX(-120%); }
  .hs__halo.is-shine::after { animation: hsShine 1.6s var(--hs-out) both; }
  .hs__mistwrap, .hs__ambient { position: absolute; inset: 0; pointer-events: none; }
  .hs__ambient { z-index: 0; }
  .hs__mist { position: absolute; border-radius: 50%; background: radial-gradient(closest-side, rgba(255,255,255,.85), rgba(255,255,255,0));
    opacity: .55; }
  .hs__mist--1 { width: 46%; height: 46%; left: 6%; top: 18%; }
  .hs__mist--2 { width: 38%; height: 38%; right: 4%; top: 8%; }
  .hs__mist--3 { width: 52%; height: 40%; left: 24%; bottom: 2%; }
  .hs__puff { position: absolute; left: 50%; top: 22%; width: 0; height: 0; pointer-events: none; }
  .hs__p { position: absolute; left: -12px; top: -12px; width: 24px; height: 24px; border-radius: 50%;
    background: radial-gradient(closest-side, rgba(168,147,226,.75), rgba(205,190,244,.35) 55%, rgba(205,190,244,0)); opacity: 0; }
  .hs__spark { position: absolute; left: var(--x); top: var(--y); width: var(--s); height: var(--s); color: rgba(255,255,255,.9); }
  .hs__spark svg { width: 100%; height: 100%; display: block; }
  @keyframes hsShine { to { transform: translateX(120%); } }

  @media (prefers-reduced-motion: no-preference) {
    .hs__ch { animation: hsChar 1s var(--hs-out) calc(var(--i) * 45ms + 120ms) backwards; }
    .hs__copy > * { animation: hsUp .8s var(--hs-out) backwards; }
    .hs__copy > :nth-child(1) { animation-delay: .35s; }
    .hs__copy > :nth-child(2) { animation-delay: .43s; }
    .hs__copy > :nth-child(3) { animation-delay: .51s; }
    .hs__copy > :nth-child(4) { animation-delay: .59s; }
    .hs__copy > :nth-child(5) { animation-delay: .67s; }
    .hs__halo { animation: hsHalo 1.3s var(--hs-out) .15s backwards; }
    .hs__dots { animation: hsFade .8s ease .9s backwards; }
    .js .hs.is-entering .hs__slide.is-active { opacity: 0; transform: translateY(40px) scale(.94); filter: blur(10px); }
    .hs__mist--1 { animation: hsMist 11s ease-in-out infinite alternate; }
    .hs__mist--2 { animation: hsMist 14s ease-in-out -4s infinite alternate-reverse; }
    .hs__mist--3 { animation: hsMist 12s ease-in-out -7s infinite alternate; }
    .hs__spark { animation: hsFloat var(--d) ease-in-out var(--dl) infinite alternate, hsTwinkle calc(var(--d) * .7) ease-in-out var(--dl) infinite alternate; }
    @keyframes hsChar { from { opacity: 0; transform: translateY(55%) rotate(4deg); } to { opacity: 1; transform: none; } }
    @keyframes hsUp { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: none; } }
    @keyframes hsHalo { from { opacity: 0; transform: scale(.82); } to { opacity: 1; transform: none; } }
    @keyframes hsFade { from { opacity: 0; } to { opacity: 1; } }
    @keyframes hsMist { from { transform: translate(-6%, 6%) scale(.92); } to { transform: translate(8%, -10%) scale(1.12); } }
    @keyframes hsFloat { from { transform: translateY(0) rotate(0deg); } to { transform: translateY(-16px) rotate(18deg); } }
    @keyframes hsTwinkle { from { opacity: .35; } to { opacity: .95; } }
  }
  @media (max-width: 989px) { .hs__spark:nth-child(n+5) { display: none; } }

  /* ---------- Siempre en movimiento ---------- */
  .hs__slide a { perspective: 900px; }
  .hs__tilt { display: grid; place-items: center; width: 100%; height: 100%; transform-style: preserve-3d;
    transition: transform .6s var(--hs-out); }
  .hs__float { display: grid; place-items: center; width: 100%; height: 100%; }
  .hs__floor { position: absolute; left: 50%; bottom: 9%; width: 46%; height: 7%; margin-left: -23%; border-radius: 50%;
    background: radial-gradient(closest-side, var(--hs-shadow, rgba(74,56,140,.45)), rgba(0,0,0,0)); opacity: .55; pointer-events: none; }
  .hs__orbit { position: absolute; inset: -6% -14%; pointer-events: none; }
  .hs__o { position: absolute; left: 50%; top: 50%; width: 92px; height: 92px; margin: -46px 0 0 -46px; border-radius: 22px;
    background: #fff; mix-blend-mode: multiply; pointer-events: auto; will-change: transform; opacity: 0;
    transition: opacity .8s ease; }
  .hs__o.is-on { opacity: 1; }
  .hs__o--front { z-index: 1; }
  .hs__o img { width: 100%; height: 100%; object-fit: contain; padding: 10%; }
  @media (max-width: 989px) { .hs__o { width: 64px; height: 64px; margin: -32px 0 0 -32px; border-radius: 16px; } .hs__orbit { inset: -4% -12%; } }
  @media (prefers-reduced-motion: no-preference) {
    .hs__slide.is-active .hs__float { animation: hsBob 6s ease-in-out infinite; }
    .hs__slide.is-active ~ .hs__floor, .hs__floor { animation: hsFloor 6s ease-in-out infinite; }
    @keyframes hsBob { 0%, 100% { transform: translateY(0) rotate(-1.2deg); } 50% { transform: translateY(-16px) rotate(1.2deg); } }
    @keyframes hsFloor { 0%, 100% { transform: scaleX(1); opacity: .55; } 50% { transform: scaleX(.78); opacity: .32; } }
  }
  @media (prefers-reduced-motion: reduce) { .hs__orbit { display: none; } }

  @media (prefers-reduced-motion: reduce) {
    .hs__mist, .hs__puff { display: none; }
    .hs, .hs__slide, .hs__halo, .hs__text-swap { transition: none; }
    .hs__slide, .hs__slide.is-leaving { transform: none; filter: none; }
    .hs__dot[aria-current="true"]::after { animation: none; transform: none; }
  }
</style>

<section class="hs is-auto is-entering" id="hs-{{ section.id }}" aria-roledescription="carrusel" aria-label="Perfumes destacados"
  data-delay="{{ section.settings.delay }}" style="--hs-delay: {{ section.settings.delay }}s;">
  {%- assign w1 = section.settings.word_1 | split: '' -%}
  {%- assign w2 = section.settings.word_2 | split: '' -%}
  <div class="hs__ambient" aria-hidden="true" data-hs-depth="18">
    {%- assign sparks = '8%,22%,14px,7s,0s|18%,74%,10px,9s,-2s|44%,12%,9px,8s,-5s|86%,18%,16px,10s,-1s|92%,64%,11px,7.5s,-3s|62%,84%,13px,9.5s,-6s' | split: '|' -%}
    {%- for sp in sparks -%}
      {%- assign v = sp | split: ',' -%}
      <span class="hs__spark" style="--x: {{ v[0] }}; --y: {{ v[1] }}; --s: {{ v[2] }}; --d: {{ v[3] }}; --dl: {{ v[4] }};"><svg viewBox="0 0 40 40"><path d="M20 4c1 8.4 4.2 11.8 12.6 12.8C24.2 17.8 21 21.2 20 29.6 19 21.2 15.8 17.8 7.4 16.8 15.8 15.8 19 12.4 20 4Z" fill="currentColor"/></svg></span>
    {%- endfor -%}
  </div>
  <p class="hs__word" aria-hidden="true">
    {%- for c in w1 -%}<span class="hs__ch" style="--i: {{ forloop.index0 }};">{{ c }}</span>{%- endfor -%}
    {{ ' ' }}<em>{%- for c in w2 -%}<span class="hs__ch" style="--i: {{ forloop.index0 | plus: w1.size | plus: 1 }};">{{ c }}</span>{%- endfor -%}</em>
  </p>
  <div class="container hs__inner">
    <div class="hs__copy">
      <p class="hs__eyebrow"><i></i>{{ section.settings.eyebrow }}</p>
      <p class="hs__brand hs__text-swap" data-hs-brand></p>
      <h1 class="hs__title hs__text-swap" data-hs-title>{{ section.settings.fallback_title }}</h1>
      {%- if section.settings.subtitle != blank -%}<p class="hs__sub">{{ section.settings.subtitle }}</p>{%- endif -%}
      <div class="hs__cta">
        <a class="hs-btn hs-btn--main" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" data-hs-link>
          <span data-hs-cta>{{ section.settings.button_label }}</span>
          <span class="hs-btn__ico" aria-hidden="true"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M5 11 11 5M6 5h5v5"/></svg></span>
        </a>
        {%- if section.settings.button2_label != blank -%}
          <a class="hs-btn hs-btn--soft" href="{{ section.settings.button2_link }}">{{ section.settings.button2_label }}</a>
        {%- endif -%}
      </div>
    </div>

    <div class="hs__stage">
      <span class="hs__halo" aria-hidden="true" data-hs-halo></span>
      <div class="hs__mistwrap" aria-hidden="true" data-hs-depth="8">
        <span class="hs__mist hs__mist--1"></span><span class="hs__mist hs__mist--2"></span><span class="hs__mist hs__mist--3"></span>
      </div>
      <span class="hs__floor" aria-hidden="true"></span>
      <span class="hs__puff" aria-hidden="true" data-hs-puff></span>
      {%- assign orbit_col = collections[section.settings.orbit_handle] -%}
      {%- if section.settings.orbit_count > 0 and orbit_col != blank -%}
        <div class="hs__orbit" data-hs-orbit>
          {%- for op in orbit_col.products limit: section.settings.orbit_count -%}
            {%- if op.featured_image -%}
              <a class="hs__o" href="{{ op.url }}" data-hs-o tabindex="-1" aria-label="{{ op.title | escape }}">
                {{ op.featured_image | image_url: width: 220 | image_tag: loading: 'lazy', widths: '140, 220', sizes: '92px', alt: '' }}
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
      {%- assign n = 0 -%}
      {%- for i in (1..3) -%}
        {%- assign key = 'product_' | append: i -%}
        {%- assign tkey = 'tint_' | append: i -%}
        {%- assign skey = 'shadow_' | append: i -%}
        {%- assign p = section.settings[key] -%}
        {%- if p != blank and p.featured_image -%}
          <figure class="hs__slide{% if n == 0 %} is-active{% endif %}" data-hs-slide
            data-tint="{{ section.settings[tkey] }}" data-shadow="{{ section.settings[skey] }}"
            data-brand="{{ p.vendor | escape }}" data-title="{{ p.title | escape }}" data-url="{{ p.url }}"
            data-price="{{ p.price | money }}" role="group" aria-roledescription="diapositiva" aria-label="{{ n | plus: 1 }} de {{ count }}">
            <a href="{{ p.url }}" tabindex="{% if n == 0 %}0{% else %}-1{% endif %}" aria-label="{{ p.title | escape }}">
              <span class="hs__tilt" data-hs-tilt><span class="hs__float">
                {{ p.featured_image | image_url: width: 1000 | image_tag: widths: '400, 600, 800, 1000', sizes: '(min-width: 990px) 40vw, 78vw',
                   loading: 'eager', fetchpriority: 'high', alt: p.title }}
              </span></span>
            </a>
          </figure>
          {%- assign n = n | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
  {%- if n > 1 -%}
    <div class="hs__dots" role="tablist" aria-label="Elegir perfume">
      {%- for i in (1..n) -%}
        <button type="button" class="hs__dot" role="tab" aria-label="Perfume {{ i }}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}" data-hs-dot="{{ forloop.index0 }}"></button>
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

<script>
  (() => {
    const root = document.getElementById('hs-{{ section.id }}');
    if (!root) return;
    const slides = [...root.querySelectorAll('[data-hs-slide]')];
    const dots = [...root.querySelectorAll('[data-hs-dot]')];
    const brand = root.querySelector('[data-hs-brand]');
    const title = root.querySelector('[data-hs-title]');
    const link = root.querySelector('[data-hs-link]');
    const cta = root.querySelector('[data-hs-cta]');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const delay = (parseFloat(root.dataset.delay) || 5.5) * 1000;
    let i = 0, timer = null, paused = false;
    const halo = root.querySelector('[data-hs-halo]');
    const puff = root.querySelector('[data-hs-puff]');

    // Rocío de perfume: partículas que salen del pico del frasco y se disuelven
    function spray() {
      if (reduce || !puff || !Element.prototype.animate) return;
      for (let k = 0; k < 18; k++) {
        const p = document.createElement('span');
        p.className = 'hs__p';
        puff.appendChild(p);
        const ang = (-90 + (Math.random() * 110 - 55)) * Math.PI / 180;
        const dist = 60 + Math.random() * 120;
        const x = Math.cos(ang) * dist, y = Math.sin(ang) * dist;
        const s = .6 + Math.random() * 1.4;
        p.animate([
          { transform: 'translate(0,0) scale(.4)', opacity: 0 },
          { transform: `translate(${x * .35}px, ${y * .35}px) scale(${s})`, opacity: .9, offset: .25 },
          { transform: `translate(${x}px, ${y}px) scale(${s * 1.8})`, opacity: 0 }
        ], { duration: 1300 + Math.random() * 600, delay: k * 18, easing: 'cubic-bezier(.23, 1, .32, 1)', fill: 'both' })
          .onfinish = () => p.remove();
      }
    }
    // Brillo que cruza el círculo de luz
    function shine() {
      if (reduce || !halo) return;
      halo.classList.remove('is-shine'); void halo.offsetWidth; halo.classList.add('is-shine');
    }

    function paint(s, instant) {
      root.style.backgroundColor = s.dataset.tint || '';
      root.style.setProperty('--hs-shadow', s.dataset.shadow || 'rgba(122,104,184,.6)');
      const apply = () => {
        brand.textContent = s.dataset.brand + ' · ' + s.dataset.price;
        title.textContent = s.dataset.title;
        if (link) link.href = s.dataset.url;
        if (cta) cta.textContent = 'Ver este perfume';
        brand.classList.remove('is-out'); title.classList.remove('is-out');
      };
      if (instant || reduce) return apply();
      brand.classList.add('is-out'); title.classList.add('is-out');
      setTimeout(apply, 320);
    }
    function go(n) {
      if (!slides.length) return;
      n = (n + slides.length) % slides.length;
      if (n === i) return;
      const prev = slides[i];
      prev.classList.remove('is-active'); prev.classList.add('is-leaving');
      prev.querySelector('a').tabIndex = -1;
      setTimeout(() => prev.classList.remove('is-leaving'), 900);
      i = n;
      slides[i].classList.add('is-active');
      slides[i].querySelector('a').tabIndex = 0;
      dots.forEach((d, k) => { d.setAttribute('aria-current', String(k === i)); });
      if (dots[i]) { dots[i].style.animation = 'none'; void dots[i].offsetWidth; dots[i].style.animation = ''; }
      paint(slides[i]);
      setTimeout(() => { spray(); shine(); }, 350);
      schedule();
    }
    function schedule() {
      clearTimeout(timer);
      if (reduce || paused || slides.length < 2) return;
      timer = setTimeout(() => go(i + 1), delay);
    }
    dots.forEach((d) => d.addEventListener('click', () => { go(Number(d.dataset.hsDot)); }));
    root.addEventListener('mouseenter', () => { paused = true; root.classList.add('is-paused'); clearTimeout(timer); });
    root.addEventListener('mouseleave', () => { paused = false; root.classList.remove('is-paused'); schedule(); });
    root.addEventListener('focusin', () => { paused = true; root.classList.add('is-paused'); clearTimeout(timer); });
    document.addEventListener('visibilitychange', () => { document.hidden ? clearTimeout(timer) : schedule(); });
    if (reduce) root.classList.remove('is-auto');
    if (slides[0]) paint(slides[0], true);

    // Entrada: el primer perfume aparece desenfocado y se enfoca cuando su foto ya cargó
    const firstImg = slides[0] && slides[0].querySelector('img');
    const reveal = () => requestAnimationFrame(() => requestAnimationFrame(() => {
      root.classList.remove('is-entering');
      setTimeout(() => { spray(); shine(); }, 650);
    }));
    if (!firstImg || firstImg.complete) setTimeout(reveal, 250);
    else { firstImg.addEventListener('load', reveal, { once: true }); setTimeout(reveal, 2500); }

    // Paralaje suave con el mouse (solo computadora): estrellitas y bruma a distintas profundidades
    if (!reduce && window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
      const layers = [...root.querySelectorAll('[data-hs-depth]')];
      let tx = 0, ty = 0, cx = 0, cy = 0, raf = 0;
      const loop = () => {
        cx += (tx - cx) * .08; cy += (ty - cy) * .08;
        layers.forEach((l) => { const d = Number(l.dataset.hsDepth); l.style.transform = `translate3d(${cx * d}px, ${cy * d}px, 0)`; });
        raf = Math.abs(tx - cx) + Math.abs(ty - cy) > .001 ? requestAnimationFrame(loop) : 0;
      };
      root.addEventListener('pointermove', (e) => {
        const r = root.getBoundingClientRect();
        tx = (e.clientX - r.left) / r.width - .5; ty = (e.clientY - r.top) / r.height - .5;
        if (!raf) raf = requestAnimationFrame(loop);
      });
      root.addEventListener('pointerleave', () => { tx = 0; ty = 0; if (!raf) raf = requestAnimationFrame(loop); });
    }
    // Órbita: los perfumes giran en una elipse; los de adelante pasan sobre el frasco y los de atrás por detrás
    const orbit = root.querySelector('[data-hs-orbit]');
    const items = orbit ? [...orbit.querySelectorAll('[data-hs-o]')] : [];
    if (orbit && items.length && !reduce) {
      let visible = true, last = performance.now(), ang = 0, rafO = 0;
      const speed = (Math.PI * 2) / {{ section.settings.orbit_seconds | default: 28 }} / 1000;
      const step = (t) => {
        const dt = Math.min(64, t - last); last = t;
        ang += dt * speed;
        const rx = orbit.offsetWidth / 2 - 40, ry = orbit.offsetHeight * .16;
        items.forEach((el, k) => {
          const a = ang + (k / items.length) * Math.PI * 2;
          const x = Math.cos(a) * rx, y = Math.sin(a) * ry + orbit.offsetHeight * .1;
          const depth = (Math.sin(a) + 1) / 2;               // 0 = atrás, 1 = adelante
          const sc = .55 + depth * .55;
          el.style.transform = `translate3d(${x.toFixed(1)}px, ${y.toFixed(1)}px, 0) scale(${sc.toFixed(3)}) rotate(${(Math.cos(a) * -8).toFixed(1)}deg)`;
          el.classList.toggle('hs__o--front', depth > .55);
        });
        rafO = visible && !document.hidden ? requestAnimationFrame(step) : 0;
      };
      new IntersectionObserver(([en]) => {
        visible = en.isIntersecting;
        if (visible && !rafO) { last = performance.now(); rafO = requestAnimationFrame(step); }
      }).observe(root);
      document.addEventListener('visibilitychange', () => { if (!document.hidden && visible && !rafO) { last = performance.now(); rafO = requestAnimationFrame(step); } });
      step(performance.now());
      setTimeout(() => items.forEach((el, k) => setTimeout(() => el.classList.add('is-on'), k * 70)), 900);
    }

    // Inclinación 3D del frasco siguiendo al mouse (solo computadora)
    if (!reduce && window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
      const stage = root.querySelector('.hs__stage');
      stage.addEventListener('pointermove', (e) => {
        const r = stage.getBoundingClientRect();
        const px = (e.clientX - r.left) / r.width - .5, py = (e.clientY - r.top) / r.height - .5;
        const t = root.querySelector('.hs__slide.is-active [data-hs-tilt]');
        if (t) t.style.transform = `rotateY(${(px * 22).toFixed(2)}deg) rotateX(${(-py * 16).toFixed(2)}deg) scale(1.03)`;
      });
      stage.addEventListener('pointerleave', () => root.querySelectorAll('[data-hs-tilt]').forEach((t) => (t.style.transform = '')));
    }
    schedule();
  })();
</script>

