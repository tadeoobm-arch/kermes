{%- comment -%}
  Banner principal con perfumes reales que rotan (hasta 3).
  - Cada perfume tiene su color de fondo; la foto (fondo blanco) se funde con "multiply".
    El "multiply" va en la diapositiva (no en la foto) y el escenario no puede crear una capa aislada
    (z-index, transform, filter, animación), o el fondo blanco de la foto vuelve a verse.
  - Cambio automático cada pocos segundos (se pausa al pasar el mouse, al tocar un punto o si la pestaña no está visible).
  - El título grande se desplaza suave con el scroll (solo en navegadores con animaciones por scroll).
  - Con "reducir movimiento": sin rotación automática ni desplazamientos.
{%- endcomment -%}
{%- liquid
  assign count = 0
  for i in (1..3)
    assign key = 'product_' | append: i
    if section.settings[key] != blank
      assign count = count | plus: 1
    endif
  endfor
-%}
<style>
  .hs { --hs-ease: cubic-bezier(.32, .72, 0, 1); position: relative; overflow: hidden; isolation: isolate;
    min-height: min(88dvh, 860px); display: grid; align-items: center; background: var(--hs-tint, #E7E1EF);
    transition: background-color 1.1s var(--hs-ease); }
  .hs::before { content: ''; position: absolute; inset: -20%; z-index: -1; pointer-events: none;
    background: radial-gradient(42% 46% at 72% 46%, rgba(255,255,255,.75) 0%, rgba(255,255,255,0) 70%),
                radial-gradient(30% 30% at 12% 90%, rgba(255,255,255,.35) 0%, rgba(255,255,255,0) 70%); }
  .hs__inner { position: relative; display: grid; gap: 28px; padding-block: 56px 72px; }
  .hs__word { position: absolute; z-index: 0; left: 50%; top: 50%; translate: -50% -50%; margin: 0; white-space: nowrap; pointer-events: none;
    font: 500 clamp(88px, 19vw, 290px)/.82 var(--f-display, 'Fraunces', serif); letter-spacing: -.045em; color: rgba(255,255,255,.62);
    text-align: center; user-select: none; }
  .hs__word em { font-style: italic; color: rgba(255,255,255,.4); }
  .hs__copy { position: relative; z-index: 2; max-width: 34rem; }
  .hs__eyebrow { display: inline-flex; align-items: center; gap: 8px; margin: 0 0 18px; padding: 6px 12px; border-radius: 999px;
    background: rgba(255,255,255,.62); font-size: 11px; font-weight: 700; letter-spacing: .18em; text-transform: uppercase; color: var(--c-ink); }
  .hs__eyebrow i { width: 6px; height: 6px; border-radius: 50%; background: var(--c-iris); }
  .hs__brand { margin: 0 0 6px; font-size: 13px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: var(--c-iris); min-height: 1.4em; }
  .hs__title { margin: 0 0 14px; font: 400 clamp(32px, 4.2vw, 54px)/1.04 var(--f-display, 'Fraunces', serif); letter-spacing: -.02em; color: var(--c-ink);
    text-wrap: balance; min-height: 2.08em; }
  .hs__sub { margin: 0 0 26px; max-width: 46ch; color: #4a4560; line-height: 1.6; text-wrap: pretty; }
  .hs__cta { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; }
  .hs-btn { display: inline-flex; align-items: center; gap: 12px; padding: 8px 8px 8px 24px; min-height: 54px; border-radius: 999px;
    font-weight: 700; text-decoration: none; transition: transform .5s var(--hs-ease), box-shadow .5s var(--hs-ease), background-color .3s ease; }
  .hs-btn--main { background: var(--c-ink); color: #fff; box-shadow: 0 18px 34px -18px rgba(47,42,74,.7); }
  .hs-btn--soft { background: rgba(255,255,255,.7); color: var(--c-ink); padding-right: 24px; }
  .hs-btn__ico { display: grid; place-items: center; width: 38px; height: 38px; border-radius: 50%; background: rgba(255,255,255,.14);
    transition: transform .5s var(--hs-ease); }
  .hs-btn__ico svg { width: 16px; height: 16px; }
  @media (hover: hover) and (pointer: fine) {
    .hs-btn:hover { transform: translateY(-2px); }
    .hs-btn--main:hover { box-shadow: 0 24px 40px -18px rgba(47,42,74,.8); }
    .hs-btn:hover .hs-btn__ico { transform: translate(3px, -2px) scale(1.06); }
    .hs-btn--soft:hover { background: #fff; }
  }
  .hs-btn:active { transform: scale(.98); transition-duration: .12s; }

  .hs__stage { position: relative; display: grid; place-items: center; aspect-ratio: 1 / 1; width: min(100%, 520px); justify-self: center; }
  .hs__halo { position: absolute; inset: 9%; border-radius: 50%; background: rgba(255,255,255,.55);
    box-shadow: 0 60px 90px -50px var(--hs-shadow, rgba(122,104,184,.6)); transition: box-shadow 1.1s var(--hs-ease); }
  .hs__slide { position: absolute; inset: 0; display: grid; place-items: center; margin: 0; opacity: 0;
    transform: translateY(28px) scale(.92) rotate(-2deg); filter: blur(6px);
    transition: opacity .9s var(--hs-ease), transform 1.1s var(--hs-ease), filter .9s var(--hs-ease); pointer-events: none;
    mix-blend-mode: multiply; }
  .hs__slide.is-active { opacity: 1; transform: none; filter: none; pointer-events: auto; }
  .hs__slide.is-leaving { opacity: 0; transform: translateY(-22px) scale(1.04) rotate(2deg); filter: blur(4px); }
  .hs__slide a { display: grid; place-items: center; width: 100%; height: 100%; }
  .hs__slide img { width: 78%; height: 78%; object-fit: contain; }
  .hs__dots { position: absolute; z-index: 3; left: 0; right: 0; bottom: 22px; display: flex; justify-content: center; gap: 8px; }
  .hs__dot { width: 34px; height: 4px; padding: 0; border: 0; border-radius: 4px; background: rgba(47,42,74,.18); cursor: pointer; overflow: hidden; position: relative; }
  .hs__dot::after { content: ''; position: absolute; inset: 0; background: var(--c-ink); transform: scaleX(0); transform-origin: left; }
  .hs__dot[aria-current="true"]::after { animation: hsBar var(--hs-delay, 5.5s) linear forwards; }
  .hs.is-paused .hs__dot[aria-current="true"]::after { animation-play-state: paused; }
  .hs:not(.is-auto) .hs__dot[aria-current="true"]::after { animation: none; transform: none; }
  @keyframes hsBar { to { transform: scaleX(1); } }
  .hs__text-swap { transition: opacity .45s ease, transform .6s var(--hs-ease); }
  .hs__text-swap.is-out { opacity: 0; transform: translateY(10px); }

  @media (min-width: 990px) {
    .hs__inner { grid-template-columns: 1fr 1fr; gap: 48px; padding-block: 72px 96px; }
  }
  @media (max-width: 989px) {
    .hs { min-height: auto; }
    .hs__inner { text-align: center; padding-block: 36px 64px; }
    .hs__copy { order: 2; justify-self: center; }
    .hs__cta { justify-content: center; }
    .hs__stage { width: min(78vw, 380px); }
    .hs__word { top: 30%; }
  }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .hs__word { animation: hsDrift linear both; animation-timeline: view(); animation-range: exit 0% exit 100%; }
      @keyframes hsDrift { to { transform: translateY(-18%); opacity: .3; } }
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hs, .hs__slide, .hs__halo, .hs__text-swap { transition: none; }
    .hs__slide, .hs__slide.is-leaving { transform: none; filter: none; }
    .hs__dot[aria-current="true"]::after { animation: none; transform: none; }
  }
</style>

<section class="hs is-auto" id="hs-{{ section.id }}" aria-roledescription="carrusel" aria-label="Perfumes destacados"
  data-delay="{{ section.settings.delay }}" style="--hs-delay: {{ section.settings.delay }}s;">
  <p class="hs__word" aria-hidden="true">{{ section.settings.word_1 }} <em>{{ section.settings.word_2 }}</em></p>
  <div class="container hs__inner">
    <div class="hs__copy">
      <p class="hs__eyebrow"><i></i>{{ section.settings.eyebrow }}</p>
      <p class="hs__brand hs__text-swap" data-hs-brand></p>
      <h1 class="hs__title hs__text-swap" data-hs-title>{{ section.settings.fallback_title }}</h1>
      {%- if section.settings.subtitle != blank -%}<p class="hs__sub">{{ section.settings.subtitle }}</p>{%- endif -%}
      <div class="hs__cta">
        <a class="hs-btn hs-btn--main" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" data-hs-link>
          <span data-hs-cta>{{ section.settings.button_label }}</span>
          <span class="hs-btn__ico" aria-hidden="true"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M5 11 11 5M6 5h5v5"/></svg></span>
        </a>
        {%- if section.settings.button2_label != blank -%}
          <a class="hs-btn hs-btn--soft" href="{{ section.settings.button2_link }}">{{ section.settings.button2_label }}</a>
        {%- endif -%}
      </div>
    </div>

    <div class="hs__stage">
      <span class="hs__halo" aria-hidden="true"></span>
      {%- assign n = 0 -%}
      {%- for i in (1..3) -%}
        {%- assign key = 'product_' | append: i -%}
        {%- assign tkey = 'tint_' | append: i -%}
        {%- assign skey = 'shadow_' | append: i -%}
        {%- assign p = section.settings[key] -%}
        {%- if p != blank and p.featured_image -%}
          <figure class="hs__slide{% if n == 0 %} is-active{% endif %}" data-hs-slide
            data-tint="{{ section.settings[tkey] }}" data-shadow="{{ section.settings[skey] }}"
            data-brand="{{ p.vendor | escape }}" data-title="{{ p.title | escape }}" data-url="{{ p.url }}"
            data-price="{{ p.price | money }}" role="group" aria-roledescription="diapositiva" aria-label="{{ n | plus: 1 }} de {{ count }}">
            <a href="{{ p.url }}" tabindex="{% if n == 0 %}0{% else %}-1{% endif %}" aria-label="{{ p.title | escape }}">
              {{ p.featured_image | image_url: width: 1000 | image_tag: widths: '400, 600, 800, 1000', sizes: '(min-width: 990px) 40vw, 78vw',
                 loading: 'eager', fetchpriority: 'high', alt: p.title }}
            </a>
          </figure>
          {%- assign n = n | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
  {%- if n > 1 -%}
    <div class="hs__dots" role="tablist" aria-label="Elegir perfume">
      {%- for i in (1..n) -%}
        <button type="button" class="hs__dot" role="tab" aria-label="Perfume {{ i }}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}" data-hs-dot="{{ forloop.index0 }}"></button>
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

<script>
  (() => {
    const root = document.getElementById('hs-{{ section.id }}');
    if (!root) return;
    const slides = [...root.querySelectorAll('[data-hs-slide]')];
    const dots = [...root.querySelectorAll('[data-hs-dot]')];
    const brand = root.querySelector('[data-hs-brand]');
    const title = root.querySelector('[data-hs-title]');
    const link = root.querySelector('[data-hs-link]');
    const cta = root.querySelector('[data-hs-cta]');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const delay = (parseFloat(root.dataset.delay) || 5.5) * 1000;
    let i = 0, timer = null, paused = false;

    function paint(s, instant) {
      root.style.backgroundColor = s.dataset.tint || '';
      root.style.setProperty('--hs-shadow', s.dataset.shadow || 'rgba(122,104,184,.6)');
      const apply = () => {
        brand.textContent = s.dataset.brand + ' · ' + s.dataset.price;
        title.textContent = s.dataset.title;
        if (link) link.href = s.dataset.url;
        if (cta) cta.textContent = 'Ver este perfume';
        brand.classList.remove('is-out'); title.classList.remove('is-out');
      };
      if (instant || reduce) return apply();
      brand.classList.add('is-out'); title.classList.add('is-out');
      setTimeout(apply, 320);
    }
    function go(n) {
      if (!slides.length) return;
      n = (n + slides.length) % slides.length;
      if (n === i) return;
      const prev = slides[i];
      prev.classList.remove('is-active'); prev.classList.add('is-leaving');
      prev.querySelector('a').tabIndex = -1;
      setTimeout(() => prev.classList.remove('is-leaving'), 900);
      i = n;
      slides[i].classList.add('is-active');
      slides[i].querySelector('a').tabIndex = 0;
      dots.forEach((d, k) => { d.setAttribute('aria-current', String(k === i)); });
      if (dots[i]) { dots[i].style.animation = 'none'; void dots[i].offsetWidth; dots[i].style.animation = ''; }
      paint(slides[i]);
      schedule();
    }
    function schedule() {
      clearTimeout(timer);
      if (reduce || paused || slides.length < 2) return;
      timer = setTimeout(() => go(i + 1), delay);
    }
    dots.forEach((d) => d.addEventListener('click', () => { go(Number(d.dataset.hsDot)); }));
    root.addEventListener('mouseenter', () => { paused = true; root.classList.add('is-paused'); clearTimeout(timer); });
    root.addEventListener('mouseleave', () => { paused = false; root.classList.remove('is-paused'); schedule(); });
    root.addEventListener('focusin', () => { paused = true; root.classList.add('is-paused'); clearTimeout(timer); });
    document.addEventListener('visibilitychange', () => { document.hidden ? clearTimeout(timer) : schedule(); });
    if (reduce) root.classList.remove('is-auto');
    if (slides[0]) paint(slides[0], true);
    schedule();
  })();
</script>

{% schema %}
{
  "name": "Banner con perfumes",
  "class": "section-hero-showcase",
  "settings": [
    { "type": "text", "id": "word_1", "label": "Palabra grande 1", "default": "Nova" },
    { "type": "text", "id": "word_2", "label": "Palabra grande 2 (cursiva)", "default": "Parfum" },
    { "type": "text", "id": "eyebrow", "label": "Etiqueta", "default": "Perfumería online · Uruguay" },
    { "type": "text", "id": "fallback_title", "label": "Título si no hay perfumes", "default": "Tu próxima fragancia favorita" },
    { "type": "textarea", "id": "subtitle", "label": "Texto" },
    { "type": "text", "id": "button_label", "label": "Botón principal", "default": "Ver perfumes" },
    { "type": "url", "id": "button_link", "label": "Enlace del botón principal (si no hay perfumes)" },
    { "type": "text", "id": "button2_label", "label": "Botón secundario" },
    { "type": "url", "id": "button2_link", "label": "Enlace del botón secundario" },
    { "type": "range", "id": "delay", "label": "Segundos por perfume", "min": 3, "max": 10, "step": 0.5, "default": 5.5 },
    { "type": "header", "content": "Perfume 1" },
    { "type": "product", "id": "product_1", "label": "Perfume" },
    { "type": "color", "id": "tint_1", "label": "Color de fondo", "default": "#DDE3F1" },
    { "type": "text", "id": "shadow_1", "label": "Sombra (rgba)", "default": "rgba(44, 62, 120, .55)" },
    { "type": "header", "content": "Perfume 2" },
    { "type": "product", "id": "product_2", "label": "Perfume" },
    { "type": "color", "id": "tint_2", "label": "Color de fondo", "default": "#F2E0DF" },
    { "type": "text", "id": "shadow_2", "label": "Sombra (rgba)", "default": "rgba(150, 52, 48, .45)" },
    { "type": "header", "content": "Perfume 3" },
    { "type": "product", "id": "product_3", "label": "Perfume" },
    { "type": "color", "id": "tint_3", "label": "Color de fondo", "default": "#E6E9E3" },
    { "type": "text", "id": "shadow_3", "label": "Sombra (rgba)", "default": "rgba(60, 70, 60, .45)" }
  ],
  "presets": [{ "name": "Banner con perfumes" }]
}
{% endschema %}
