{%- comment -%}
  Invitación a seguir la cuenta de Instagram, con un collage de perfumes de la tienda
  (son fotos de productos, no publicaciones). Si el usuario carga fotos propias en "Imágenes",
  se usan esas en lugar de los productos.
{%- endcomment -%}
{%- assign col = section.settings.collection -%}
<style>
  .igc { padding-block: clamp(56px, 8vw, 104px); }
  .igc__core { position: relative; display: grid; gap: 28px; align-items: center; padding: 32px 22px; border-radius: 32px; overflow: hidden;
    background: linear-gradient(135deg, #2F2A4A 0%, #4A3E7A 55%, #7A68B8 100%); color: #fff; }
  .igc__core::after { content: ''; position: absolute; width: 420px; height: 420px; right: -120px; top: -160px; border-radius: 50%;
    background: radial-gradient(closest-side, rgba(233,201,207,.45), rgba(233,201,207,0)); pointer-events: none; }
  .igc__eyebrow { margin: 0 0 10px; font-size: 11px; font-weight: 700; letter-spacing: .18em; text-transform: uppercase; color: #CDBEF4; }
  .igc__title { margin: 0 0 12px; font: 400 clamp(30px, 4vw, 48px)/1.05 var(--f-display, 'Fraunces', serif); letter-spacing: -.02em; }
  .igc__text { margin: 0 0 22px; max-width: 40ch; color: rgba(255,255,255,.78); line-height: 1.6; }
  .igc__btn { display: inline-flex; align-items: center; gap: 12px; padding: 8px 8px 8px 22px; min-height: 52px; border-radius: 999px;
    background: #fff; color: var(--c-ink); font-weight: 700; text-decoration: none; transition: transform .5s cubic-bezier(.32,.72,0,1); }
  .igc__btn span { display: grid; place-items: center; width: 36px; height: 36px; border-radius: 50%;
    background: radial-gradient(circle at 30% 107%, #fdf497 0%, #fd5949 45%, #d6249f 60%, #285AEB 90%); color: #fff; }
  .igc__btn svg { width: 18px; height: 18px; }
  @media (hover: hover) and (pointer: fine) { .igc__btn:hover { transform: translateY(-2px); } }
  .igc__btn:active { transform: scale(.98); }
  .igc__grid { position: relative; z-index: 1; display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin: 0; padding: 0; list-style: none; }
  .igc__grid li { aspect-ratio: 1; border-radius: 18px; background: #fff; overflow: hidden; display: grid; place-items: center;
    box-shadow: 0 18px 30px -20px rgba(0,0,0,.5); transition: transform .7s cubic-bezier(.32,.72,0,1); }
  .igc__grid li:nth-child(2), .igc__grid li:nth-child(5) { transform: translateY(14px); }
  .igc__grid img { width: 84%; height: 84%; object-fit: contain; mix-blend-mode: multiply; }
  .igc__grid img.is-photo { width: 100%; height: 100%; object-fit: cover; mix-blend-mode: normal; }
  @media (hover: hover) and (pointer: fine) { .igc__grid li:hover { transform: translateY(-6px) rotate(-1.5deg); } }
  @media (min-width: 990px) { .igc__core { grid-template-columns: .9fr 1.1fr; gap: 56px; padding: 56px; } }
</style>
<section class="igc">
  <div class="container">
    <div class="igc__core">
      <div>
        <p class="igc__eyebrow">Instagram</p>
        <h2 class="igc__title">{{ section.settings.title }}</h2>
        <p class="igc__text">{{ section.settings.text }}</p>
        {%- if settings.social_instagram != blank -%}
          <a class="igc__btn" href="{{ settings.social_instagram }}" target="_blank" rel="noopener">Seguir {{ section.settings.handle }}
            <span aria-hidden="true">{% render 'icon', name: 'instagram' %}</span></a>
        {%- endif -%}
      </div>
      <ul class="igc__grid" aria-hidden="true">
        {%- assign shown = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.settings.image and shown < 6 -%}
            <li {{ block.shopify_attributes }}>{{ block.settings.image | image_url: width: 400 | image_tag: loading: 'lazy', class: 'is-photo', alt: '' }}</li>
            {%- assign shown = shown | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
        {%- if shown == 0 and col != blank -%}
          {%- for p in col.products limit: 6 -%}
            {%- if p.featured_image -%}<li>{{ p.featured_image | image_url: width: 360 | image_tag: loading: 'lazy', widths: '200, 360', sizes: '(min-width: 990px) 14vw, 30vw', alt: '' }}</li>{%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      </ul>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Seguinos en Instagram",
  "settings": [
    { "type": "text", "id": "title", "label": "Título", "default": "Seguinos en Instagram" },
    { "type": "textarea", "id": "text", "label": "Texto", "default": "Novedades, lanzamientos y perfumes que llegan cada semana." },
    { "type": "text", "id": "handle", "label": "Usuario", "default": "@novaparfum.uy" },
    { "type": "collection", "id": "collection", "label": "Colección para el collage (si no cargás imágenes)" }
  ],
  "blocks": [ { "type": "photo", "name": "Imagen", "settings": [ { "type": "image_picker", "id": "image", "label": "Imagen" } ] } ],
  "max_blocks": 6,
  "presets": [{ "name": "Seguinos en Instagram" }]
}
{% endschema %}
