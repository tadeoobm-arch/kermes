<!doctype html>
<html lang="{{ request.locale.iso_code }}" class="no-js">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="theme-color" content="{{ settings.color_background }}">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
      <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180, height: 180 }}">
    {%- else -%}
      <link rel="icon" type="image/svg+xml" href="{{ 'favicon.svg' | asset_url }}">
    {%- endif -%}

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;1,9..144,400&family=Manrope:wght@400;500;600;700&display=swap">

    {%- liquid
      assign page_title_full = page_title
      if current_tags
        assign tags_text = current_tags | join: ', '
        assign page_title_full = page_title_full | append: ' – ' | append: tags_text
      endif
      if current_page != 1
        assign page_title_full = page_title_full | append: ' – Página ' | append: current_page
      endif
      unless page_title contains shop.name
        assign page_title_full = page_title_full | append: ' | ' | append: shop.name
      endunless
    -%}
    <title>{{ page_title_full }}</title>
    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {% render 'meta-tags' %}
    {% render 'structured-data' %}

    <style>
      :root {
        --c-bg: {{ settings.color_background }};
        --c-surface: {{ settings.color_surface }};
        --c-ink: {{ settings.color_ink }};
        --c-iris: {{ settings.color_iris }};
        --c-powder: {{ settings.color_powder }};
        --c-sage: {{ settings.color_sage }};
        --c-stone: {{ settings.color_stone }};
        --c-line: {{ settings.color_line }};
        --c-sale: {{ settings.color_sale }};
      }
    </style>
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {% render 'card-violet' %}
    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>
    <script>document.documentElement.className = document.documentElement.className.replace('no-js', 'js');</script>

    {{ content_for_header }}
  </head>

  <body class="template-{{ template.name }}">
    <a class="skip-link" href="#MainContent">Saltar al contenido</a>
    {% render 'nova-motion' %}
    {% render 'nova-polish' %}
    {% sections 'header-group' %}

    <main id="MainContent" class="main" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% render 'cart-toast' %}

    {% render 'social-float' %}

    <script>
      window.NovaParfum = {
        routes: {
          cart_add_url: '{{ routes.cart_add_url }}',
          cart_url: '{{ routes.cart_url }}',
          cart_change_url: '{{ routes.cart_change_url }}',
          root_url: '{{ routes.root_url }}'
        },
        moneyFormat: {{ shop.money_format | json }}
      };
    </script>
  </body>
</html>
