{%- comment -%}
  Frasco NovaParfum "NOVA No. 01" en SVG (reutilizable).
  Parámetros: uid (texto único por uso), liquid_a / liquid_b / liquid_c (colores del líquido, arriba → abajo),
  label (texto grande, por defecto NOVA), number (por defecto No. 01), class (clase extra para el <svg>).
  El brillo del vidrio usa la clase .nb__sheen (cada sección decide si lo anima).
{%- endcomment -%}
{%- liquid
  assign u = uid | default: 'nb'
  assign la = liquid_a | default: '#F7CF7E'
  assign lb = liquid_b | default: '#D88B2E'
  assign lc = liquid_c | default: '#8E4A14'
-%}
<svg class="nb {{ class }}" viewBox="0 0 240 400" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="nbLiq-{{ u }}" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="{{ la }}"/><stop offset=".55" stop-color="{{ lb }}"/><stop offset="1" stop-color="{{ lc }}"/></linearGradient>
    <linearGradient id="nbSide-{{ u }}" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#000" stop-opacity=".3"/><stop offset=".25" stop-color="#000" stop-opacity="0"/><stop offset=".7" stop-color="#fff" stop-opacity=".12"/><stop offset="1" stop-color="#000" stop-opacity=".32"/></linearGradient>
    <linearGradient id="nbGlass-{{ u }}" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#fff" stop-opacity=".7"/><stop offset=".12" stop-color="#fff" stop-opacity=".14"/><stop offset=".5" stop-color="#fff" stop-opacity=".04"/><stop offset=".88" stop-color="#fff" stop-opacity=".18"/><stop offset="1" stop-color="#fff" stop-opacity=".6"/></linearGradient>
    <linearGradient id="nbGold-{{ u }}" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#8B6A2E"/><stop offset=".3" stop-color="#F5E1A6"/><stop offset=".55" stop-color="#C9A050"/><stop offset=".8" stop-color="#F0D693"/><stop offset="1" stop-color="#7A5A22"/></linearGradient>
    <linearGradient id="nbCap-{{ u }}" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#0E0C0B"/><stop offset=".35" stop-color="#3A3330"/><stop offset=".55" stop-color="#171413"/><stop offset="1" stop-color="#050404"/></linearGradient>
    <clipPath id="nbBody-{{ u }}"><path d="M44 124 H196 L212 140 V362 L196 378 H44 L28 362 V140Z"/></clipPath>
  </defs>
  <rect x="76" y="8" width="88" height="78" rx="5" fill="url(#nbCap-{{ u }})"/>
  <rect x="76" y="8" width="88" height="6" rx="3" fill="url(#nbGold-{{ u }})"/>
  <rect x="84" y="14" width="6" height="70" fill="#fff" opacity=".12"/>
  <rect x="88" y="86" width="64" height="22" rx="2" fill="url(#nbGold-{{ u }})"/>
  <rect x="98" y="108" width="44" height="16" fill="url(#nbGold-{{ u }})" opacity=".85"/>
  <path d="M44 124 H196 L212 140 V362 L196 378 H44 L28 362 V140Z" fill="rgba(255,255,255,.22)"/>
  <g clip-path="url(#nbBody-{{ u }})">
    <rect x="0" y="150" width="240" height="260" fill="url(#nbLiq-{{ u }})"/>
    <rect x="0" y="146" width="240" height="8" fill="#fff" opacity=".3"/>
    <rect x="0" y="120" width="240" height="270" fill="url(#nbSide-{{ u }})"/>
    <rect class="nb__sheen" x="-60" y="110" width="34" height="290" fill="#fff" opacity=".42" transform="skewX(-14)"/>
    <rect x="20" y="346" width="200" height="40" fill="#fff" opacity=".2"/>
  </g>
  <path d="M44 124 H196 L212 140 V362 L196 378 H44 L28 362 V140Z" fill="url(#nbGlass-{{ u }})" stroke="rgba(255,255,255,.9)" stroke-width="2"/>
  <path d="M36 146 V356" stroke="#fff" stroke-width="5" stroke-linecap="round" opacity=".65"/>
  <path d="M204 150 V350" stroke="#fff" stroke-width="2" stroke-linecap="round" opacity=".5"/>
  <rect x="70" y="196" width="100" height="118" rx="2" fill="#F8F1E4" stroke="#C9A050" stroke-width="1.2"/>
  <rect x="75" y="201" width="90" height="108" rx="1" fill="none" stroke="#C9A050" stroke-width=".6"/>
  <path transform="translate(111 210) scale(.45)" d="M20 4c1 8.4 4.2 11.8 12.6 12.8C24.2 17.8 21 21.2 20 29.6 19 21.2 15.8 17.8 7.4 16.8 15.8 15.8 19 12.4 20 4Z" fill="#C9A050"/>
  <text x="120" y="250" text-anchor="middle" font-family="Fraunces, serif" font-size="22" letter-spacing="5" fill="#2B2420">{{ label | default: 'NOVA' }}</text>
  <text x="120" y="272" text-anchor="middle" font-family="Fraunces, serif" font-style="italic" font-size="15" fill="#9A6A30">{{ number | default: 'No. 01' }}</text>
  <text x="120" y="292" text-anchor="middle" font-family="Manrope, sans-serif" font-size="6" letter-spacing="2.2" fill="#6B5E55">EAU DE PARFUM</text>
  <text x="120" y="303" text-anchor="middle" font-family="Manrope, sans-serif" font-size="5.5" letter-spacing="1.6" fill="#9C8F84">NOVAPARFUM · URUGUAY</text>
</svg>
